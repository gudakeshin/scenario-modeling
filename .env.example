# Backend
PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/scenario_modeling
FRONTEND_ORIGIN=http://localhost:3000

# Anthropic Claude for NL parsing, reflection, business analysis, narrative
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Perplexity for real-time macro/news research (optional — enables web search for macroeconomic scenarios)
# PERPLEXITY_API_KEY=pplx-...
# PERPLEXITY_MODEL=sonar

# Rate limiting (requests per window)
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX_REQUESTS=120

# Session TTL (default: 24 hours)
# SESSION_TTL_MS=86400000

# Input validation
# MAX_INPUT_LENGTH=2000

# Default system user
# DEFAULT_USER_EMAIL=system@scenario-modeling.local
# DEFAULT_USER_NAME=System User
# DEFAULT_USER_ROLE=analyst

# Qdrant Vector Database (for Document RAG / Talk-to-Document)
# QDRANT_URL=https://your-cluster.qdrant.io:6333
# QDRANT_API_KEY=your-qdrant-api-key
# QDRANT_COLLECTION=scenario_documents

# Embedding (optional — if not set, uses local hash-based embeddings)
# For better quality, configure an OpenAI-compatible embedding endpoint:
# EMBEDDING_API_URL=https://api.openai.com/v1/embeddings
# EMBEDDING_API_KEY=sk-...
# EMBEDDING_MODEL=text-embedding-3-small
