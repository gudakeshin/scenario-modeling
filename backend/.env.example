# Copy to .env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/scenario_modeling

# Required: at least 32 characters. Generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
JWT_ISSUER=scenario-modeling
JWT_AUDIENCE=scenario-modeling-api
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_SEC=604800

FRONTEND_ORIGIN=http://localhost:3000

# Anthropic (required in production)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# Optional model routing overrides
# ANTHROPIC_MODEL_PARSE=claude-haiku-4-5-20251001
# ANTHROPIC_MODEL_ANALYSIS=claude-sonnet-4-5-20250929

# Perplexity (optional — macro/news research)
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=sonar

# LlamaParse (LlamaCloud) — document parsing. https://cloud.llamaindex.ai
LLAMA_CLOUD_API_KEY=
LLAMA_PARSE_CSV=false

# Rate limits
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120
AUTH_RATE_LIMIT_MAX=20

SESSION_TTL_MS=3600000
MAX_INPUT_LENGTH=2000

# Auth provider: local (OIDC later)
AUTH_PROVIDER=local

# Dev-only: seed demo mappings / formulas (never enable in production)
# See docs/adr/0004-demo-mode.md
DEMO_MODE=false

# Optional — reserved for future Sentry (see backend/src/errorReporter.ts; no @sentry/node required yet)
# SENTRY_DSN=

# Document search: "none" = Postgres keyword search only (default);
# "openai" = OpenAI-compatible embeddings (requires URL + key below)
EMBEDDING_PROVIDER=none
# EMBEDDING_API_URL=https://api.openai.com/v1/embeddings
# EMBEDDING_API_KEY=
# EMBEDDING_MODEL=text-embedding-3-small
