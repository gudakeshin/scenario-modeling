# Copy to .env and fill in real values. Never commit .env.

# Runtime
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/scenario_modeling

# JWT
# Required: at least 32 characters. Generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
JWT_ISSUER=scenario-modeling
JWT_AUDIENCE=scenario-modeling-api
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_SEC=604800

# CORS / Frontend
FRONTEND_ORIGIN=http://localhost:3000
# Optional extra origins (comma-separated). FRONTEND_ORIGIN is always included.
FRONTEND_ORIGINS=

# Anthropic (required in production)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# Optional model routing overrides
# ANTHROPIC_MODEL_PARSE=
# ANTHROPIC_MODEL_ANALYSIS=
# ANTHROPIC_MODEL_QA=

# Perplexity (optional)
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=sonar

# LlamaCloud / LlamaParse (optional)
LLAMA_CLOUD_API_KEY=
LLAMA_PARSE_CSV=false

# Qdrant (deprecated; kept optional for migration)
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=

# Embeddings
EMBEDDING_PROVIDER=none
# EMBEDDING_API_URL=https://api.openai.com/v1/embeddings
# EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120
AUTH_RATE_LIMIT_MAX=20
SESSION_TTL_MS=3600000
MAX_INPUT_LENGTH=2000

# Object storage (optional — workbook bytes)
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_FORCE_PATH_STYLE=false

# Redis (optional — shared session/context cache)
REDIS_URL=
# Async ingestion defaults on when REDIS_URL is configured
# INGESTION_ASYNC_ENABLED=true
INGESTION_JOB_TIMEOUT_MS=300000
DOCUMENT_UPLOAD_MAX_MB=50

# HyperFormula runtime memory controls
XLSX_RUNTIME_MAX_CELLS=5000000
XLSX_RUNTIME_CACHE_MAX_ENTRIES=10
XLSX_RUNTIME_CACHE_TTL_MS=1800000

# Optional malware scanning (required in hardened deployments)
CLAMAV_HOST=
CLAMAV_PORT=3310
CLAMAV_REQUIRED=false

# Auth provider
AUTH_PROVIDER=local

# OIDC (optional — when AUTH_PROVIDER=oidc)
# OIDC_ISSUER=https://login.example.com/
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_AUDIENCE=
OIDC_REDIRECT_URI=http://localhost:4000/api/v1/auth/oidc/callback
# OIDC_AUTHORIZATION_ENDPOINT=
# OIDC_TOKEN_ENDPOINT=

# Optional: Sentry
SENTRY_DSN=

# Dev-only
DEMO_MODE=false

# Planning connectors gate (SAP SAC / Anaplan)
ENABLE_PLANNING_CONNECTORS=false
# 64 hex chars (32 bytes) for connector secrets and per-document AES-GCM keys.
# Required when ENABLE_PLANNING_CONNECTORS is on and for enterprise deployments.
# CREDENTIALS_ENCRYPTION_KEY=

# Simulation / extraction tuning
EXTERNAL_MODEL_MAX_CELLS=500000
SAC_DEFAULT_PAGE_SIZE=1000
SAC_MAX_FACT_PAGES=10000
SAC_HTTP_MAX_RETRIES=4
ANAPLAN_HTTP_MAX_RETRIES=4
ANAPLAN_MAX_MODULES_PER_MODEL=100
ANAPLAN_READ_POLL_INTERVAL_MS=1500
ANAPLAN_READ_POLL_TIMEOUT_MS=600000

# Accounting thresholds
ABSURDITY_THRESHOLD_PCT=200
IDENTITY_REPAIR_TOLERANCE=0.01
FIDELITY_ABS_TOLERANCE=0.5
FIDELITY_REL_TOLERANCE=0.01
FIDELITY_READY_THRESHOLD=0.95
MC_DEFAULT_PERCENT_SPREAD_PP=5
MC_DEFAULT_RELATIVE_STDDEV=0.1
AGENT_MAX_STEPS=8
AGENT_TIMEOUT_MS=120000
GOAL_SEEK_MAX_ITERATIONS=40

# Feature gates
FIDELITY_AGENT_ENABLED=false
SHOWCASE_AGENT_ENABLED=false
DEPLOYMENT_PROFILE=standard

# HyperFormula licensing (production fail-fast)
# Must be a commercial Handsoncode license key; production rejects gpl-v3.
HYPERFORMULA_LICENSE_KEY=gpl-v3

# /metrics protection (production fail-fast)
METRICS_TOKEN=

# Postgres pool tuning
PG_POOL_MAX=10
PG_STATEMENT_TIMEOUT_MS=30000

# Connector tuning / SSRF egress policy
CONNECTOR_HTTP_TIMEOUT_MS=30000
CONNECTOR_EGRESS_ALLOWLIST=

# Test / transitional auth setting:
# when true, /auth/refresh and /auth/login may include refresh_token in JSON bodies.
AUTH_REFRESH_BODY_FALLBACK=false

# Seed (dev/CI) — used by backend/scripts/seed-dev.ts
# Required for CI/test.
SEED_ADMIN_PASSWORD=

