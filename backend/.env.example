# Copy to .env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/scenario_modeling

# Required: at least 32 characters. Generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
JWT_ISSUER=scenario-modeling
JWT_AUDIENCE=scenario-modeling-api
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_SEC=604800

FRONTEND_ORIGIN=http://localhost:3000

# Anthropic (required in production)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# Optional model routing overrides
# ANTHROPIC_MODEL_PARSE=claude-haiku-4-5-20251001
# Defaults to claude-sonnet-5 when unset (business_analysis / context_build)
# ANTHROPIC_MODEL_ANALYSIS=claude-sonnet-5
# Defaults to claude-opus-4-8 when unset (QA judge / agentic reasoner)
# ANTHROPIC_MODEL_QA=claude-opus-4-8

# Perplexity (optional — macro/news research)
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=sonar

# LlamaParse (LlamaCloud) — document parsing. https://cloud.llamaindex.ai
LLAMA_CLOUD_API_KEY=
LLAMA_PARSE_CSV=false

# Rate limits
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120
AUTH_RATE_LIMIT_MAX=20

SESSION_TTL_MS=3600000
MAX_INPUT_LENGTH=2000

# Auth provider: local | oidc
AUTH_PROVIDER=local
# OIDC (when AUTH_PROVIDER=oidc)
# OIDC_ISSUER=https://login.example.com/
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_AUDIENCE=
# OIDC_REDIRECT_URI=http://localhost:4000/api/v1/auth/oidc/callback
# OIDC_AUTHORIZATION_ENDPOINT=
# OIDC_TOKEN_ENDPOINT=

# Redis for shared sessions (optional — falls back to memory)
# REDIS_URL=redis://localhost:6379

# S3-compatible object storage for workbook bytes (optional — BYTEA fallback)
# OBJECT_STORAGE_ENDPOINT=http://localhost:9000
# OBJECT_STORAGE_BUCKET=scenario-modeling
# OBJECT_STORAGE_ACCESS_KEY=
# OBJECT_STORAGE_SECRET_KEY=
# OBJECT_STORAGE_REGION=us-east-1
# OBJECT_STORAGE_FORCE_PATH_STYLE=true

# Dev-only: seed demo mappings / fixtures (never enable in production)
# Known P&L identity repairs are production-safe when they tie out to source values.
# See docs/adr/0004-demo-mode.md
DEMO_MODE=false

# Showcase agentic reasoning (requires validated model + merged business context)
# SHOWCASE_AGENT_ENABLED=false
# Or enable via profile: standard | showcase | enterprise
# DEPLOYMENT_PROFILE=standard

# LLM accounting-fidelity agent on residual simulation violations (off by default)
# FIDELITY_AGENT_ENABLED=false

# Analytical thresholds (optional)
# ABSURDITY_THRESHOLD_PCT=200
# IDENTITY_REPAIR_TOLERANCE=0.01
# FIDELITY_ABS_TOLERANCE=0.5
# FIDELITY_REL_TOLERANCE=0.01
# FIDELITY_READY_THRESHOLD=0.95

# Optional — Sentry (backend @sentry/node + frontend @sentry/nextjs)
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=

# Document search: "none" = Postgres keyword search only (default);
# "openai" = OpenAI-compatible embeddings (requires URL + key below)
EMBEDDING_PROVIDER=none
# EMBEDDING_API_URL=https://api.openai.com/v1/embeddings
# EMBEDDING_API_KEY=
# EMBEDDING_MODEL=text-embedding-3-small