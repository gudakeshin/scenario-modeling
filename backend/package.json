{
  "name": "scenario-modeling-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "db:migrate": "node-pg-migrate up --tsx --envPath .env",
    "db:migrate:down": "node-pg-migrate down --tsx --envPath .env",
    "db:seed": "tsx scripts/seed-dev.ts",
    "test": "npm run build && NODE_ENV=test node --test --test-force-exit dist/services/parser.test.js dist/services/xlsxStructural.test.js dist/services/xlsxSimulation.test.js dist/tests/authz.test.js dist/tests/workspaces.test.js",
    "test:e2e": "npm run build && NODE_ENV=test node --test --test-force-exit dist/tests/e2e.test.js",
    "test:all": "npm run build && NODE_ENV=test node --test --test-force-exit dist/services/parser.test.js dist/services/xlsxStructural.test.js dist/services/xlsxSimulation.test.js dist/tests/authz.test.js dist/tests/workspaces.test.js dist/tests/e2e.test.js",
    "lint": "eslint src"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.74.0",
    "argon2": "^0.44.0",
    "cors": "^2.8.5",
    "csv-parse": "^5.6.0",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.21.0",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "hyperformula": "^3.2.0",
    "jose": "^6.2.3",
    "llama-cloud-services": "^0.5.4",
    "multer": "^2.0.2",
    "node-pg-migrate": "^8.0.4",
    "openai": "^4.52.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.12.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pptxgenjs": "^4.0.1",
    "prom-client": "^15.1.3",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-rate-limit": "^5.1.3",
    "@types/multer": "^2.1.0",
    "@types/node": "^20.11.0",
    "@types/pg": "^8.11.6",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.28.0",
    "supertest": "^7.2.2",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.33.0"
  }
}
